<Project>
  <PropertyGroup>
    <HasDriveD Condition="Exists('D:\')">true</HasDriveD>
    <CelularBuildRoot Condition="'$(CelularBuildRoot)' == '' and '$(HasDriveD)' == 'true'">D:\tools\CelularGR09</CelularBuildRoot>
    <CelularPackagesRoot Condition="'$(CelularPackagesRoot)' == '' and '$(HasDriveD)' == 'true'">D:\NuGet\packages</CelularPackagesRoot>
    <CelularBuildRoot Condition="'$(CelularBuildRoot)' == '' and '$(HasDriveD)' != 'true'">$(MSBuildThisFileDirectory).artifacts</CelularBuildRoot>

    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <BaseIntermediateOutputPath Condition="'$(CelularBuildRoot)' != ''">$(CelularBuildRoot)\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <BaseOutputPath Condition="'$(CelularBuildRoot)' != ''">$(CelularBuildRoot)\bin\$(MSBuildProjectName)\</BaseOutputPath>
    <RestorePackagesPath Condition="'$(CelularPackagesRoot)' != ''">$(CelularPackagesRoot)</RestorePackagesPath>
  </PropertyGroup>
</Project>
